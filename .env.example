# ──────────────────────────────────────────────────────────────────────────────
# Hospital Decision Intelligence Platform — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# 1. Copy this file: cp .env.example .env
# 2. Fill in ALL values marked with <CHANGE_ME>
# 3. NEVER commit the .env file to version control
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=<CHANGE_ME_256_BIT_RANDOM_KEY>
PROJECT_NAME=Hospital Decision Intelligence Platform
VERSION=1.0.0

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=hip_user
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_DB_PASSWORD>
POSTGRES_DB=hip_db
DATABASE_URL=postgresql+asyncpg://hip_user:<CHANGE_ME_STRONG_DB_PASSWORD>@postgres:5432/hip_db
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,https://<CHANGE_ME_YOUR_DOMAIN>

# ── Nginx ─────────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80

# ── Token and Session ─────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
